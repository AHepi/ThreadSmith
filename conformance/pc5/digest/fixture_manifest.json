  "output_binding_requirements": [
    {
      "id": "exact_input_preserved",
      "assertion": "DigestedSource contains a DefaultedSource value equal to the exact consumed input"
    },
    {
      "id": "digest_source_binding",
      "assertion": "the contained BlueprintDigest is calculated from the contained DefaultedSource"
    },
    {
      "id": "no_public_mismatch_constructor",
      "assertion": "public API cannot construct DigestedSource from independently supplied source and digest"
    },
    {
      "id": "repeatable_digest",
      "assertion": "equal cloned DefaultedSource inputs produce equal BlueprintDigest values"
    },
    {
      "id": "no_metadata_or_authority",
      "assertion": "DigestedSource adds no canonical bytes, provenance, diagnostic, artifact, permission, Binding, or authority field"
    }
  ],
  "deferred_identity_kinds": [
    "package",
    "resource",
    "contract",
    "unit",
    "link",
    "policy",
    "scenario",
    "lock",
    "manifest",
    "qualification",
    "binding",
    "envelope",
    "event"
  ],
  "implementation_test_requirements": {
    "decode_and_compare_every_canonical_utf8_hex": true,
    "verify_every_canonical_vector_sha256": true,
    "reject_bom_whitespace_and_trailing_newline_in_golden_output": true,
    "exercise_reachable_sources_through_public_pc2_pc3_pc4_pc5_path": true,
    "minimum_digest_runs_per_reachable_source": 3,
    "assert_exact_digest_text": true,
    "assert_source_preserved_in_digested_source": true,
    "assert_no_public_source_digest_pairing": true,
    "assert_no_pc5_source_diagnostics": true,
    "assert_no_pc5_canonical_byte_output_field": true,
    "assert_no_later_identity_or_authority": true
  }
