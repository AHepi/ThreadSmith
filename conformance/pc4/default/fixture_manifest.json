    {
      "id": "malformed_and_ambiguous_values_are_preserved",
      "class": "boundary_deferred",
      "input": {
        "lattice": "0.3",
        "profile": "lattice-core-0.1",
        "module": "deferred_invalid",
        "version": "1.0.0",
        "purpose": "Preserve later-invalid data",
        "inputs": [null, {"input": "invalid", "required": null, "cardinality": [], "on_absence": {}}, {"input": "partial"}],
        "units": [
          null,
          {"unit": "missing_kind", "inputs": {"not": "an_array"}, "outputs": [null, {"port": "out"}]},
          {"unit": "numeric_kind", "kind": 7, "inputs": [{"port": "in"}]},
          {"unit": "unknown_kind", "kind": "store", "outputs": [{"port": "out"}]},
          {"unit": "model_invalid", "kind": "model", "mode": null, "repair_attempts": "many", "fallback": []}
        ],
        "links": [null, {"link": "invalid", "mode": null, "delivery": [], "when": false}, {"link": "partial"}],
        "policies": [7, {"policy": "invalid", "when": null}, {"policy": "partial"}],
        "exports": [7, {"export": "invalid", "cardinality": null}, {"export": "partial"}],
        "scenarios": [false, {"scenario": "invalid", "required": null}, {"scenario": "partial"}]
      },
      "expected": {
        "result": "expanded",
        "semantic_status": "later_validation_deferred",
        "output": {
          "lattice": "0.3",
          "profile": "lattice-core-0.1",
          "module": "deferred_invalid",
          "version": "1.0.0",
          "purpose": "Preserve later-invalid data",
          "imports": [],
          "inputs": [null, {"input": "invalid", "required": null, "cardinality": [], "on_absence": {}}, {"input": "partial", "required": true, "cardinality": "one", "on_absence": "block"}],
          "contracts": [],
          "resources": [],
          "units": [
            null,
            {"unit": "missing_kind", "inputs": {"not": "an_array"}, "outputs": [null, {"port": "out", "cardinality": "one"}]},
            {"unit": "numeric_kind", "kind": 7, "inputs": [{"port": "in", "required": true, "cardinality": "one", "on_absence": "block"}]},
            {"unit": "unknown_kind", "kind": "store", "outputs": [{"port": "out", "cardinality": "one"}]},
            {"unit": "model_invalid", "kind": "model", "mode": null, "repair_attempts": "many", "fallback": []}
          ],
          "links": [null, {"link": "invalid", "mode": null, "delivery": [], "when": false}, {"link": "partial", "mode": "data", "delivery": "multicast", "when": {"all": []}}],
          "policies": [7, {"policy": "invalid", "when": null}, {"policy": "partial", "when": {"all": []}}],
          "exports": [7, {"export": "invalid", "cardinality": null}, {"export": "partial", "cardinality": "one"}],
          "scenarios": [false, {"scenario": "invalid", "required": null}, {"scenario": "partial", "required": true}]
        }
      },
      "covers": ["non-object preservation", "invalid explicit preservation", "invalid nested container", "ambiguous unit kinds", "context-independent defaults", "no PC4 diagnostic"]
    },
