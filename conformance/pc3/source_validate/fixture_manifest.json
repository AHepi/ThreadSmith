      "expected": {"result":"valid_unchanged","semantic_status":"deferred"},
      "covers": ["valid-looking declarations", "references", "contracts", "ports and links", "policies", "no semantic endorsement"]
    },
    {
      "id": "deferred_invalid_declaration_semantics",
      "class": "boundary_deferred",
