      "expected": {"result":"valid_unchanged","semantic_status":"deferred"},
      "covers": ["invalid declaration name", "duplicate name", "missing fields and references", "Extended-only kind", "invalid route and policy", "unbounded control", "invalid budget", "secret value"]
    },
    {
